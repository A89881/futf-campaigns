rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isPortfolioAdmin() {
      return request.auth != null
        && request.auth.token.email == 'bakwert0123@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /portfolio/experience {
      allow read: if true;
      allow create, update: if isPortfolioAdmin()
        && request.resource.data.keys().hasOnly(['entries', 'updatedAt'])
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 50;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
