rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isPortfolioAdmin() {
      return request.auth != null
        && request.auth.token.email == 'bakwert0123@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /portfolio/experience {
      allow read: if true;
      allow create, update: if isPortfolioAdmin()
        && request.resource.data.keys().hasOnly(['entries', 'updatedAt'])
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 50;
      allow delete: if false;
    }

    match /portfolio/appendix {
      allow read: if true;
      allow create, update: if isPortfolioAdmin()
        && request.resource.data.keys().hasOnly(['documents', 'updatedAt'])
        && request.resource.data.documents is list
        && request.resource.data.documents.size() <= 50;
      allow delete: if false;
    }

    match /portfolio/projects {
      allow read: if true;
      allow create, update: if isPortfolioAdmin()
        && request.resource.data.keys().hasOnly(['order', 'hidden', 'updatedAt'])
        && request.resource.data.order is list
        && request.resource.data.order.size() <= 50
        && request.resource.data.hidden is list
        && request.resource.data.hidden.size() <= 50;
      allow delete: if false;
    }

    match /portfolio/content {
      allow read: if true;
      allow create, update: if isPortfolioAdmin()
        && request.resource.data.keys().hasOnly(['entries', 'updatedAt'])
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 600;
      allow delete: if false;
    }

    match /portfolio/pages {
      allow read: if true;
      allow create, update: if isPortfolioAdmin()
        && request.resource.data.keys().hasOnly(['pages', 'updatedAt'])
        && request.resource.data.pages is list
        && request.resource.data.pages.size() <= 30;
      allow delete: if false;
    }

    match /contactSubmissions/{submissionId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 180
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
